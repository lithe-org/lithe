<Page
    x:Class="Lithe_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Lithe_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="460">
        <TextBlock
            Text="Lithe 桌面层控制台"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.ToggleClickThroughCommand}" Content="切换鼠标穿透" />
            <Button Command="{x:Bind ViewModel.AttachToWorkerWCommand}" Content="挂载 WorkerW" />
            <Button Command="{x:Bind ViewModel.DetachFromWorkerWCommand}" Content="切回顶层" />
            <Button Command="{x:Bind ViewModel.RefreshStatusCommand}" Content="刷新状态" />
        </StackPanel>
    </StackPanel>
</Page>